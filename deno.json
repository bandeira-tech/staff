{
  "name": "@bandeira-tech/b3nd-cc-chat",
  "version": "0.0.1",
  "exports": {
    ".": "./src/mod.ts",
    "./protocol": "./src/protocol.ts",
    "./node": "./src/node.ts",
    "./http": "./src/http.ts",
    "./mcp": "./src/mcp.ts"
  },
  "imports": {
    "@bandeira-tech/b3nd-core": "jsr:@bandeira-tech/b3nd-core@^0.22.0",
